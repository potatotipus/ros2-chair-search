<?xml version="1.0"?>
<window>
  <width>1280</width><height>720</height>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>3D View</title>
    <property key="state" type="string">docked</property>
    <property key="showTitleBar" type="bool">false</property>
  </gz-gui>
  <engine>ogre2</engine><scene>scene</scene>
  <ambient_light>0.65 0.65 0.65</ambient_light>
  <background_color>0.85 0.90 0.95</background_color>
  <camera_pose>-6.5 -6.5 8 0 0.72 0.785398</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="View Control">
  <gz-gui><property key="visible" type="bool">false</property><property key="state" type="string">floating</property></gz-gui>
</plugin>
<plugin filename="WorldControl" name="World Control">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="width" type="double">220</property><property key="height" type="double">60</property>
    <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <play_pause>true</play_pause><step>false</step><start_paused>false</start_paused>
  <stats_topic>/world/warehouse/stats</stats_topic>
</plugin>
<plugin filename="VideoRecorder" name="Video Recorder">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="width" type="double">60</property><property key="height" type="double">60</property>
    <property key="x" type="double">15</property><property key="y" type="double">15</property>
  </gz-gui>
  <record_video><use_sim_time>true</use_sim_time><lockstep>true</lockstep><bitrate>4000000</bitrate></record_video>
</plugin>
